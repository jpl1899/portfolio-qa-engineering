# Toolshop SUT configuration. Copy to .env and adjust to your local setup.
# Bun loads .env automatically. Exact ports and seeded credentials are
# pinned in sut/docker-compose.yml (added in module 01).

# --- URLs ---
# Laravel serves the API at the docroot — no `/api` prefix (verified against
# the live routes; RouteServiceProvider registers routes/api.php unprefixed).
SUT_WEB_URL=http://localhost:8091
SUT_API_URL=http://localhost:8091

# --- Database (Compose MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=toolshop

# --- Seeded users ---
ADMIN_EMAIL=admin@practicesoftwaretesting.com
ADMIN_PASSWORD=welcome01
CUSTOMER_EMAIL=customer@practicesoftwaretesting.com
CUSTOMER_PASSWORD=welcome01
